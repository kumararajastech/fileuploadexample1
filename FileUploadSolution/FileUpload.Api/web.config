<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\FileUpload.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <!--
          Set the storage location on the server. Do not put a password here.
          <environmentVariables>
            <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
            <environmentVariable name="FileStorage__SharedFolderPath" value="\\FileServer\SharedFiles" />
          </environmentVariables>
        -->
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Absolute ceiling. The application enforces FileStorage:MaxFileSizeInMB, which cannot exceed 512 MB. -->
          <requestLimits maxAllowedContentLength="537919488" />
        </requestFiltering>
      </security>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
    </system.webServer>
  </location>
</configuration>
