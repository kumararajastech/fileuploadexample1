{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "SharedFolderPath": "",
    "MaxFileSizeInMB": 20,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".csv",
      ".txt",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  },
  "Security": {
    "RequireAuthentication": true
  }
}
